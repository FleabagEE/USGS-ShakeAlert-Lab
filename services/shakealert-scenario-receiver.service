[Unit]
Description=QuakeLogic passive ShakeAlert Scenario OpenWire receiver
Documentation=file:/opt/quakelogic/shakealert-lab/docs/scenario-service-deployment.md
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
ConditionPathIsDirectory=/opt/quakelogic/shakealert-lab/credentials/scenario/QuakeLogic-SA1
[Service]
Type=simple
User=quakelogic
Group=quakelogic
WorkingDirectory=/opt/quakelogic/shakealert-lab
UMask=0027
RuntimeDirectory=shakealert-scenario-receiver
RuntimeDirectoryMode=0750
StateDirectory=shakealert-scenario-receiver
StateDirectoryMode=0750
ExecStartPre=/opt/quakelogic/shakealert-lab/bin/java-receiver verify-runtime
ExecStart=/opt/quakelogic/shakealert-lab/bin/java-receiver run --subscribe scenario.eew.shakealert.org 61612 QuakeLogic-SA1 eew.test_QuakeLogic-SA1.dm.data /var/lib/shakealert-scenario-receiver/captures 16777216 /run/shakealert-scenario-receiver/health.json /var/lib/shakealert-scenario-receiver/rejections
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=45s
SendSIGKILL=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shakealert-scenario-receiver
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/quakelogic/shakealert-lab/credentials/scenario/QuakeLogic-SA1
ReadWritePaths=/run/shakealert-scenario-receiver /var/lib/shakealert-scenario-receiver
[Install]
WantedBy=multi-user.target
